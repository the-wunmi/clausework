# Postgres (docker-compose.yml). Generate the password once, e.g. `openssl rand -hex 24`, and use
# the same value in both URLs below. It takes effect when the database volume is first created.
POSTGRES_USER=clausework
POSTGRES_PASSWORD=
POSTGRES_DB=clausework
DATABASE_URL=postgres://clausework:<POSTGRES_PASSWORD>@localhost:5434/clausework
# DBOS records workflows here, so interrupted work resumes after a restart.
DBOS_SYSTEM_DATABASE_URL=postgres://clausework:<POSTGRES_PASSWORD>@localhost:5434/clausework_dbos
ANTHROPIC_API_KEY=

# PayPal: sandbox calls api-m.sandbox.paypal.com, live calls api-m.paypal.com.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Usage-Based Billing is limited release; set true once /v1/commerce/billing/activate succeeds.
PAYPAL_USAGE_BILLING=

# Optional: set your own owner key instead of the one generated (and printed once) on first start.
CLAUSEWORK_OWNER_KEY=
# Optional: where to post things that need the owner (a Slack incoming webhook works as is).
CLAUSEWORK_ALERT_WEBHOOK_URL=
# Optional: your business's IANA time zone. It decides when each day starts, so a charge due on
# 1 December falls due at midnight there. Defaults to UTC.
CLAUSEWORK_TIMEZONE=

# Public origin of the web app, used in portal and PayPal return links.
CLAUSEWORK_PUBLIC_URL=http://localhost:3000

# Optional AG Grid / AG Studio licence keys (built into the web app; without them a trial watermark shows).
NEXT_PUBLIC_AG_GRID_LICENSE=
NEXT_PUBLIC_AG_STUDIO_LICENSE=
