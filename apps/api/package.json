{
  "name": "@clausework/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "owner-key:reset": "tsx --env-file-if-exists=../../.env src/reset-owner-key.ts",
    "webhook:register": "tsx --env-file-if-exists=../../.env src/register-webhook.ts"
  },
  "dependencies": {
    "@clausework/core": "workspace:*",
    "@clausework/db": "workspace:*",
    "@clausework/engine": "workspace:*",
    "@clausework/paypal": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
